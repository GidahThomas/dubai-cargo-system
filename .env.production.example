# Production settings for cPanel hosting.
# On the server: copy this file to ".env" (same folder) and fill in the values marked CHANGE.
# Never upload your local .env from the shop computer.

APP_ENV=production
APP_DEBUG=false

# CHANGE: from cPanel > MySQL Databases (cPanel adds your account prefix, e.g. abcd_dubaitech)
DB_HOST=localhost
DB_NAME=CHANGE_cpaneluser_dbname
DB_USER=CHANGE_cpaneluser_dbuser
DB_PASS=CHANGE_database_password
DB_CHARSET=utf8mb4

# Outgoing email: use the mailbox you create in cPanel > Email Accounts.
SMTP_HOST=CHANGE_mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=CHANGE_info@yourdomain.com
SMTP_PASSWORD=CHANGE_mailbox_password
SMTP_FROM_EMAIL=CHANGE_info@yourdomain.com
SMTP_FROM_NAME=Dubai Tech Plaza

# Turn on once cPanel > SSL/TLS Status shows your domain with a valid certificate.
FORCE_HTTPS=true
TRUST_PROXY=false

# Error emails to the owner (max once per 30 min per error).
ERROR_ALERT_EMAIL=CHANGE_owner@yourdomain.com

# WhatsApp chat buttons (defaults to the company phone in Invoice Settings).
WHATSAPP_NUMBER=
WHATSAPP_COUNTRY_CODE=255

# Optional services: fill in when you have the accounts.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
SMS_PROVIDER=
SMS_USERNAME=
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_SENDER_ID=
SMS_SANDBOX=false
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
AZAMPAY_CALLBACK_TOKEN=
AZAMPAY_SANDBOX=true

# Backups on the server (storage/backups is outside the website and blocked from the web).
BACKUP_DIR=
BACKUP_KEEP=14
BACKUP_COPY_DIR=
MYSQL_BIN_DIR=/usr/bin

DB_TEST_NAME=
