# Settings for Vercel (free) + TiDB Cloud (free database) + Cloudinary (free image storage).
# See docs/DEPLOY_VERCEL.md.
#
# 1. In Vercel > Project > Settings > Environment Variables, add every line below (values without quotes).
# 2. On the shop computer, save a copy as ".env.tidb" (it is git-ignored) to run the set-up tools
#    against the cloud database:  C:\xampp\php\php.exe tools\migrate.php --env=.env.tidb

APP_ENV=production
APP_DEBUG=false

# Vercel runs the site from /api/index.php; links must point at the domain root instead.
APP_BASE_PATH=/
# Vercel has no permanent disk: keep sign-in sessions in the database.
SESSION_DRIVER=database
# Vercel serves HTTPS itself and forwards requests; trust its X-Forwarded-Proto header.
TRUST_PROXY=true
FORCE_HTTPS=false

# CHANGE: TiDB Cloud > your cluster > Connect (choose "General" / PHP). Host looks like
# gateway01.eu-central-1.prod.aws.tidbcloud.com; the user looks like 2abcDEF.root.
DB_HOST=CHANGE_gateway01.REGION.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=dubai_tech_plaza
DB_USER=CHANGE_xxxxxxxx.root
DB_PASS=CHANGE_tidb_password
DB_CHARSET=utf8mb4
# TiDB requires an encrypted connection. This is the certificate bundle on Vercel's servers.
# On the shop computer (.env.tidb) use C:\xampp\apache\bin\curl-ca-bundle.crt instead.
DB_SSL_CA=/etc/pki/tls/certs/ca-bundle.crt

# CHANGE: Cloudinary > Dashboard > "API environment variable".
CLOUDINARY_URL=cloudinary://CHANGE_API_KEY:CHANGE_API_SECRET@CHANGE_CLOUD_NAME
CLOUDINARY_FOLDER=dubai-tech-plaza

# CHANGE: a long random password (at least 16 characters) protecting the scheduled-jobs address.
# Vercel Cron sends it automatically; use it in cron-job.org too (see the guide).
CRON_SECRET=CHANGE_long_random_text

# Logs: Vercel shows PHP errors under Project > Logs. Error emails still work:
ERROR_ALERT_EMAIL=CHANGE_owner@example.com

# Outgoing email (e.g. a Gmail account with an App Password: smtp.gmail.com, 587, tls).
SMTP_HOST=CHANGE_smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=CHANGE_you@gmail.com
SMTP_PASSWORD=CHANGE_app_password
SMTP_FROM_EMAIL=CHANGE_you@gmail.com
SMTP_FROM_NAME=Dubai Tech Plaza

# WhatsApp chat buttons (defaults to the company phone in Invoice Settings).
WHATSAPP_NUMBER=
WHATSAPP_COUNTRY_CODE=255

# Optional services: same meaning as in .env.example.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
SMS_PROVIDER=
SMS_USERNAME=
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_SENDER_ID=
SMS_SANDBOX=false
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
AZAMPAY_CALLBACK_TOKEN=
AZAMPAY_SANDBOX=true
