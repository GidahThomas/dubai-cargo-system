# Copy this file to .env and fill in real values. .env is gitignored and never committed.

APP_ENV=local
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_NAME=dubai_computer_fast_cargo
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Leave SMTP_HOST empty to fall back to PHP's built-in mail() (not recommended for production).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
# Leave SMTP_FROM_EMAIL/SMTP_FROM_NAME blank to use the company email/name from Invoice Settings.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# WhatsApp chat links: number customers reach on WhatsApp (defaults to the company phone in Invoice Settings).
# Local numbers like 0652532646 are converted using WHATSAPP_COUNTRY_CODE.
WHATSAPP_NUMBER=
WHATSAPP_COUNTRY_CODE=255

# Automatic customer updates via the WhatsApp Business Cloud API (Meta). Leave blank to disable.
# Create an app at developers.facebook.com, add the WhatsApp product, and copy the permanent
# access token and Phone Number ID. WHATSAPP_TEMPLATE should be an approved template with two
# body variables ({{1}} title, {{2}} message); without it, only plain text inside WhatsApp's
# 24-hour customer service window is delivered.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# SMS customer updates via Africa's Talking or Beem Africa. Leave SMS_PROVIDER blank to disable.
#   africastalking: set SMS_USERNAME and SMS_API_KEY (SMS_SANDBOX=true while testing)
#   beem:           set SMS_API_KEY and SMS_SECRET_KEY
# SMS_SENDER_ID is the approved sender name shown on the phone (optional).
SMS_PROVIDER=
SMS_USERNAME=
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_SENDER_ID=
SMS_SANDBOX=false
